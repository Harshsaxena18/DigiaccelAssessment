{
  "name": "todo-list-app-root",
  "version": "1.0.0",
  "description": "Fullstack To-Do List Application",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "dev:server": "npm.cmd --prefix server run dev",
    "dev:client": "npm.cmd --prefix client run dev",
    "start:server": "npm.cmd --prefix server start",
    "test:server": "npm.cmd --prefix server test",
    "test:client": "npm.cmd --prefix client test",
    "test": "npm.cmd --prefix server test && npm.cmd --prefix client test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "mongoose": "^8.8.0",
    "zod": "^3.23.8"
  }
}
